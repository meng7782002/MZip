<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MZip</AssemblyName>
    <RootNamespace>MZip</RootNamespace>
    <AssemblyTitle>MZip 压缩解压工具</AssemblyTitle>
    <Product>MZip</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\MZip.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MZip.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\7z.exe" Link="tools\7z.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\7z.dll" Link="tools\7z.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\License.txt" Link="tools\License.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
