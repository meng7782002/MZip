<Window x:Class="MZip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MZip"
        mc:Ignorable="d"
        Title="MZip 压缩解压工具"
        Icon="pack://application:,,,/Assets/MZip.ico"
        Height="760" Width="1200"
        MinHeight="580" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 菜单 -->
        <Menu x:Name="MainMenu" Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="文件">
                <MenuItem Header="打开压缩包…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <MenuItem x:Name="RecentMenu" Header="最近打开" />
                <Separator />
                <MenuItem Header="新建压缩包…" Click="Create_Click" />
                <Separator />
                <MenuItem Header="退出" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="操作">
                <MenuItem Header="解压全部…" Click="ExtractAll_Click" />
                <MenuItem Header="解压选中…" Click="ExtractSelected_Click" />
                <Separator />
                <MenuItem Header="全选条目" InputGestureText="Ctrl+A" Click="SelectAllEntries_Click" />
                <MenuItem Header="复制选中条目" InputGestureText="Ctrl+C" Click="CopyEntries_Click" />
                <MenuItem Header="粘贴到指定文件夹…" InputGestureText="Ctrl+V" Click="PasteTo_Click" />
                <Separator />
                <MenuItem Header="添加文件…" Click="AddFiles_Click" />
                <MenuItem Header="添加文件夹…" Click="AddFolder_Click" />
                <MenuItem Header="删除选中" Click="DeleteSelected_Click" />
                <Separator />
                <MenuItem Header="测试压缩包" Click="Test_Click" />
                <MenuItem Header="刷新列表" InputGestureText="F5" Click="Refresh_Click" />
                <MenuItem Header="关闭压缩包" Click="CloseArchive_Click" />
            </MenuItem>
            <MenuItem Header="工具">
                <MenuItem Header="批量解压…" Click="BatchExtract_Click" />
                <MenuItem Header="MD5 校验…" Click="HashTool_Click" />
                <MenuItem Header="修复压缩包…" Click="Repair_Click" />
                <Separator />
                <MenuItem Header="设置…" Click="Settings_Click" />
                <MenuItem Header="关于" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel x:Name="ToolbarButtons" Orientation="Horizontal" Margin="10,6">
                    <Button Style="{StaticResource ToolButton}" Click="Open_Click" ToolTip="打开压缩包（Ctrl+O）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="打开" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExtractAllButton" Style="{StaticResource ToolButton}" Click="ExtractAll_Click" ToolTip="解压压缩包全部内容">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="解压全部" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExtractSelectedButton" Style="{StaticResource ToolButton}" Click="ExtractSelected_Click" ToolTip="仅解压选中的条目">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="解压选中" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CreateArchiveButton" Style="{StaticResource ToolButton}" Click="Create_Click" ToolTip="新建压缩包">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="新建" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="22" Fill="{StaticResource LineBrush}" Margin="10,0" VerticalAlignment="Center" />

                    <Button x:Name="AddButton" Style="{StaticResource ToolButton}" Click="AddFiles_Click" ToolTip="向当前压缩包添加文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="添加" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Click="DeleteSelected_Click" ToolTip="删除选中的条目">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="删除" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TestButton" Style="{StaticResource ToolButton}" Click="Test_Click" ToolTip="校验压缩包完整性">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="测试" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}" Click="Refresh_Click" ToolTip="刷新列表（F5）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,6" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="180" Height="30" VerticalContentAlignment="Center"
                             Style="{StaticResource InputBox}" Margin="0,0,10,0"
                             ToolTip="按名称实时过滤包内条目" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="文件名编码" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"
                               FontSize="12" Margin="0,0,6,0" ToolTip="文件名出现乱码时切换编码重新解析" />
                    <ComboBox x:Name="EncodingCombo" Width="118" VerticalContentAlignment="Center" Height="30"
                              SelectionChanged="EncodingCombo_Changed" ToolTip="文件名乱码时切换编码重新解析列表">
                        <ComboBoxItem Content="自动" Tag="0" />
                        <ComboBoxItem Content="UTF-8" Tag="65001" />
                        <ComboBoxItem Content="GBK" Tag="936" />
                        <ComboBoxItem Content="Big5" Tag="950" />
                        <ComboBoxItem Content="Shift-JIS" Tag="932" />
                        <ComboBoxItem Content="EUC-KR" Tag="949" />
                    </ComboBox>
                    <Button Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="设置">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="About_Click" ToolTip="关于 MZip">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="关于" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 压缩包信息卡片 -->
        <Border x:Name="InfoCard" Grid.Row="2" Background="White" CornerRadius="12"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Padding="16,12" Margin="12,12,12,0" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentLightBrush}">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ArchiveNameText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArchivePathText" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Click="ExtractAll_Click" Content="解压全部" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Click="CloseArchive_Click" Content="关闭" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <Border Background="#F5F8FE" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="格式" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                            <TextBlock x:Name="FormatText" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F8FE" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="文件" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                            <TextBlock x:Name="FileCountText" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F8FE" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="目录" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                            <TextBlock x:Name="FolderCountText" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F8FE" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="原始大小" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                            <TextBlock x:Name="TotalSizeText" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F8FE" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="压缩后" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                            <TextBlock x:Name="PackedSizeText" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F8FE" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="压缩率" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                            <TextBlock x:Name="RatioText" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 文件列表 / 空白状态 / 拖拽提示 -->
        <Grid Grid.Row="3" Margin="12,12,12,0">
            <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="6,0">
                <DataGrid x:Name="EntriesGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          Background="White" BorderThickness="0" RowHeaderWidth="0"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          EnableRowVirtualization="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SelectionChanged="EntriesGrid_SelectionChanged"
                          MouseDoubleClick="EntriesGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="解压选中…" Click="ExtractSelected_Click" />
                            <Separator />
                            <MenuItem Header="全选条目" Click="SelectAllEntries_Click" />
                            <MenuItem Header="复制选中条目" Click="CopyEntries_Click" />
                            <MenuItem Header="粘贴到指定文件夹…" Click="PasteTo_Click" />
                            <Separator />
                            <MenuItem Header="复制条目路径" Click="CopyName_Click" />
                            <MenuItem Header="计算 MD5" Click="ComputeEntryMd5_Click" />
                            <MenuItem Header="删除选中" Click="DeleteSelected_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="名称" Width="*" SortMemberPath="FullPath"
                                                HeaderStyle="{StaticResource LeftHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource FolderIconGeometry}" Fill="#7C8CA5" Stretch="Uniform"
                                              Width="17" Height="15" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Path Data="{StaticResource FileIconGeometry}" Fill="#7C8CA5" Stretch="Uniform"
                                              Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding FullPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Background="#FFF4DC" CornerRadius="4" Padding="5,1"
                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEncrypted}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="加密" FontSize="11" Foreground="#A8741A" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="大小" Width="110"
                                            Binding="{Binding Size, Converter={StaticResource SizeConverter}}"
                                            SortMemberPath="Size" HeaderStyle="{StaticResource RightHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="压缩后" Width="110"
                                            Binding="{Binding PackedSize, Converter={StaticResource SizeConverter}}"
                                            SortMemberPath="PackedSize" HeaderStyle="{StaticResource RightHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="压缩率" Width="90" Binding="{Binding RatioText}" SortMemberPath="Ratio"
                                            HeaderStyle="{StaticResource RightHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="修改时间" Width="140" Binding="{Binding ModifiedText}" SortMemberPath="Modified">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CRC" Width="96" Binding="{Binding Crc}" SortMemberPath="Crc">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="属性" Width="80" Binding="{Binding Attributes}" SortMemberPath="Attributes">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="EmptyState" Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource FolderIconGeometry}" Fill="#C9D4E8" Stretch="Uniform"
                          Width="64" Height="56" HorizontalAlignment="Center" />
                    <TextBlock Text="拖入压缩包，或点击下方按钮打开" FontSize="14"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                    <Button x:Name="EmptyOpenButton" Content="打开压缩包" Style="{StaticResource PrimaryButton}"
                            Width="150" Margin="0,20,0,0" Click="Open_Click" />
                    <TextBlock Text="支持 ZIP / 7Z / RAR 等常见格式" FontSize="12"
                               Foreground="#9AA7BC" Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#F2F7FF" CornerRadius="12"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="松开鼠标以打开或添加文件" FontSize="16" Margin="0,12,0,0"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="16,9" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"
                           Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="EngineText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="#9AA7BC" FontSize="11" Margin="0,0,14,0" />

                <ProgressBar x:Name="OperationProgressBar" Grid.Column="2" Width="240" Height="8"
                             Style="{StaticResource ThinProgress}" VerticalAlignment="Center" Margin="0,0,10,0"
                             Visibility="Collapsed" />

                <TextBlock x:Name="ProgressText" Grid.Column="3" Width="44" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" Margin="0,0,10,0"
                           Visibility="Collapsed" />

                <Button x:Name="CancelButton" Grid.Column="4" Content="取消" Style="{StaticResource GhostButton}"
                        Padding="12,3" Visibility="Collapsed" Click="Cancel_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
