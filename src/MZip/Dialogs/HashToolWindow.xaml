<Window x:Class="MZip.Dialogs.HashToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MD5 校验工具"
        Height="430" Width="720"
        MinHeight="380" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 文件选择区 -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathBox" Style="{StaticResource InputBox}" Height="32"
                         VerticalContentAlignment="Center" ToolTip="可直接拖入文件到本窗口"
                         IsReadOnly="True" Text="拖入文件到窗口，或点击右侧按钮选择" Foreground="{StaticResource SubTextBrush}" />
                <Button Grid.Column="1" Content="选择文件…" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" Click="Browse_Click" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="取消计算" Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" Click="Cancel_Click" IsEnabled="False" />
            </Grid>
        </Border>

        <!-- 进度 -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="HashProgress" Height="8" Style="{StaticResource ThinProgress}"
                         VerticalAlignment="Center" />
            <TextBlock x:Name="ProgressText" Grid.Column="1" Width="44" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" Margin="8,0,0,0" />
        </Grid>

        <!-- 结果区 -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Padding="14,10" Margin="0,10,0,0">
            <StackPanel>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MD5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="Md5Text" Grid.Column="1" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="复制" Style="{StaticResource GhostButton}" Padding="10,2"
                            Click="CopyMd5_Click" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SHA1" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="Sha1Text" Grid.Column="1" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="复制" Style="{StaticResource GhostButton}" Padding="10,2"
                            Click="CopySha1_Click" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SHA256" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="Sha256Text" Grid.Column="1" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="复制" Style="{StaticResource GhostButton}" Padding="10,2"
                            Click="CopySha256_Click" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CRC32" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox x:Name="Crc32Text" Grid.Column="1" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="复制" Style="{StaticResource GhostButton}" Padding="10,2"
                            Click="CopyCrc32_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 比对区 -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Padding="14,12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ExpectBox" Style="{StaticResource InputBox}" Height="32"
                         VerticalContentAlignment="Center"
                         ToolTip="粘贴期望的校验值（MD5/SHA1/SHA256/CRC32 均可），自动比对"
                         TextChanged="ExpectBox_TextChanged" />
                <TextBlock x:Name="CompareResult" Grid.Column="1" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="{StaticResource SubTextBrush}"
                   FontSize="12" Margin="2,10,0,0" Text="支持 MD5 / SHA1 / SHA256 / CRC32，大文件流式计算可取消" />
    </Grid>
</Window>
