<Window x:Class="MZip.Dialogs.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片预览"
        Height="640" Width="860"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：文件名 -->
        <Border Grid.Row="0" Background="#2A2A2A" Padding="14,9">
            <Grid>
                <TextBlock x:Name="FileNameText" Foreground="#E8E8E8" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="IndexText" Foreground="#9AA7BC" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 中部：图片显示区 -->
        <Grid Grid.Row="1" Background="#1E1E1E" ClipToBounds="True">
            <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Background="Transparent">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="PreviewImage" RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        </Image.LayoutTransform>
                    </Image>
                </Grid>
            </ScrollViewer>

            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" Height="6" />
                <TextBlock Text="正在读取图片…" Foreground="#9AA7BC" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 底部：工具按钮 -->
        <Border Grid.Row="2" Background="#2A2A2A" Padding="14,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevButton" Content="&#x2190; 上一张" Padding="14,5" Margin="0,0,8,0"
                        Click="Prev_Click" ToolTip="上一张（左方向键）" />
                <Button x:Name="NextButton" Content="下一张 &#x2192;" Padding="14,5" Margin="0,0,16,0"
                        Click="Next_Click" ToolTip="下一张（右方向键）" />
                <Button Content="适应窗口" Padding="14,5" Margin="0,0,8,0" Click="Fit_Click" ToolTip="缩放至适应窗口" />
                <Button Content="实际大小" Padding="14,5" Margin="0,0,8,0" Click="ActualSize_Click" ToolTip="按 100% 显示" />
                <TextBlock x:Name="ZoomText" Text="100%" Foreground="#9AA7BC" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
