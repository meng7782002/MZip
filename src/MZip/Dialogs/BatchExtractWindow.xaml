<Window x:Class="MZip.Dialogs.BatchExtractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量解压" Width="760" Height="560"
        WindowStartupLocation="CenterOwner" MinWidth="640" MinHeight="480"
        Background="#F4F6FA"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 列表工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12,10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="添加压缩包…" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                <Button Content="移除选中" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Remove_Click" />
                <Button Content="清空列表" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Clear_Click" />
                <TextBlock Text="可将压缩包拖入本窗口" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource SubTextBrush}" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- 包列表 -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,10,0,10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <DataGrid x:Name="PackageGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                      Background="Transparent" SelectionMode="Extended" IsReadOnly="True"
                      RowBackground="Transparent" AlternationCount="2" AlternatingRowBackground="#F7F9FD">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="压缩包" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="所在目录" Binding="{Binding Directory}" Width="2.4*" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="1.6*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 选项 -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14,10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="输出位置：" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <RadioButton x:Name="PerArchiveRadio" Content="各包所在目录下同名文件夹" IsChecked="True"
                                 VerticalAlignment="Center" Margin="6,0,0,0" Checked="OutputMode_Changed" />
                    <RadioButton x:Name="UnifiedRadio" Content="统一解压到：" VerticalAlignment="Center"
                                 Margin="14,0,0,0" Checked="OutputMode_Changed" />
                    <TextBox x:Name="UnifiedDirBox" Style="{StaticResource InputBox}" Width="240" Margin="6,0,0,0"
                             IsEnabled="False" />
                    <Button Content="浏览…" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="10,6"
                            Click="Browse_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="覆盖策略：" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <ComboBox x:Name="OverwriteCombo" Width="150" VerticalAlignment="Center" Margin="6,0,0,0">
                        <ComboBoxItem Content="覆盖已有文件" Tag="Overwrite" />
                        <ComboBoxItem Content="跳过已存在的文件" Tag="Skip" />
                        <ComboBoxItem Content="自动重命名新文件" Tag="Rename" />
                    </ComboBox>
                    <CheckBox x:Name="DeleteSourceCheck" Content="解压完成后删除源压缩包"
                              VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 进度 -->
        <StackPanel Grid.Row="3" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ProgressText" Text="就绪" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                <TextBlock x:Name="PercentText" Text="" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                           Margin="12,0,0,0" />
            </StackPanel>
            <ProgressBar x:Name="TotalProgressBar" Style="{StaticResource ThinProgress}" Margin="0,6,0,0"
                         Minimum="0" Maximum="100" Value="0" />
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StartButton" Content="开始解压" Style="{StaticResource PrimaryButton}" MinWidth="110"
                    Click="Start_Click" />
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}" MinWidth="96"
                    Margin="8,0,0,0" Click="CancelOp_Click" IsEnabled="False" />
            <Button Content="关闭" Style="{StaticResource GhostButton}" MinWidth="96" Margin="8,0,0,0"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
