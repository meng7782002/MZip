<Window x:Class="MZip.Dialogs.CreateArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建压缩包" Width="760" Height="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="新建压缩包" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="选择来源文件与格式，压缩完成后自动打开" FontSize="12"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="190" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="来源文件与文件夹" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="SourceCountText" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,8,10,0">
                <ListBox x:Name="SourcesList" BorderThickness="0" Background="White" Padding="4"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" ToolTip="{Binding}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" Margin="4,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,8,0,0" Width="118">
                <Button Content="添加文件…" Style="{StaticResource GhostButton}" Click="AddFiles_Click" />
                <Button Content="添加文件夹…" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="AddFolder_Click" />
                <Button Content="移除选中" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="RemoveSelected_Click" />
                <Button Content="清空" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="ClearSources_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#F7F9FD" CornerRadius="10" Padding="16,14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="压缩格式" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                <ComboBox x:Name="FormatCombo" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Margin="0,0,16,0"
                          SelectionChanged="FormatCombo_SelectionChanged">
                    <ComboBoxItem Content="7Z（压缩比更高）" />
                    <ComboBoxItem Content="ZIP（兼容性更好）" />
                    <ComboBoxItem Content="EXE 自解压包" />
                </ComboBox>

                <TextBlock Grid.Column="2" Text="压缩级别" VerticalAlignment="Center"
                           Foreground="{StaticResource SubTextBrush}" />
                <ComboBox x:Name="LevelCombo" Grid.Column="3" Height="34" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="仅存储（最快）" Tag="0" />
                    <ComboBoxItem Content="极速" Tag="1" />
                    <ComboBoxItem Content="快速" Tag="3" />
                    <ComboBoxItem Content="标准（推荐）" Tag="5" />
                    <ComboBoxItem Content="较高" Tag="7" />
                    <ComboBoxItem Content="极限（最慢）" Tag="9" />
                </ComboBox>

                <TextBlock Grid.Row="1" Text="分卷大小" VerticalAlignment="Center" Margin="0,12,0,0"
                           Foreground="{StaticResource SubTextBrush}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,16,0">
                    <TextBox x:Name="VolumeBox" Width="110" Height="30" VerticalContentAlignment="Center"
                             ToolTip="留空或 0 表示不分卷" />
                    <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource SubTextBrush}" />
                </StackPanel>
                <CheckBox x:Name="SolidCheck" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                          Content="固实压缩（仅 7Z）" VerticalAlignment="Center" Margin="0,12,0,0"
                          Foreground="{StaticResource SubTextBrush}" />

                <TextBlock Grid.Row="2" Text="打开密码" VerticalAlignment="Center" Margin="0,12,0,0"
                           Foreground="{StaticResource SubTextBrush}" />
                <PasswordBox x:Name="PwdBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource PasswordInput}" Margin="0,12,16,0" />
                <CheckBox x:Name="EncryptNamesCheck" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                          Content="加密文件名（仅 7Z）" VerticalAlignment="Center" Margin="0,12,0,0"
                          Foreground="{StaticResource SubTextBrush}" />

                <TextBlock x:Name="CommentLabel" Grid.Row="3" Text="压缩包注释" VerticalAlignment="Top" Margin="0,16,0,0"
                           Foreground="{StaticResource SubTextBrush}" />
                <TextBox x:Name="CommentBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="46" Margin="0,12,0,0"
                         Style="{StaticResource InputBox}" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="6,5" />

                <CheckBox x:Name="DeleteSourcesCheck" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                          Content="压缩成功后删除源文件（校验通过才删除）" VerticalAlignment="Center" Margin="0,12,0,0"
                          Foreground="{StaticResource SubTextBrush}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="保存位置" FontWeight="SemiBold" Margin="0,18,0,0" Foreground="{StaticResource TextBrush}" />
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Style="{StaticResource InputBox}" TextChanged="TargetBox_TextChanged" />
            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Browse_Click" />
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#D14343" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}" MinWidth="96" Click="Cancel_Click" IsCancel="True" />
            <Button Content="开始压缩" Style="{StaticResource PrimaryButton}" MinWidth="112" Margin="10,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
