<Window x:Class="JsjmZip.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="620" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="默认压缩格式" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
            <ComboBox x:Name="FormatCombo" Grid.Column="1" Height="34" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="250">
                <ComboBoxItem Content="7Z（压缩比更高）" />
                <ComboBoxItem Content="ZIP（兼容性更好）" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="默认压缩级别" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
            <ComboBox x:Name="LevelCombo" Grid.Column="1" Height="34" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="250">
                <ComboBoxItem Content="仅存储（最快）" Tag="0" />
                <ComboBoxItem Content="极速" Tag="1" />
                <ComboBoxItem Content="快速" Tag="3" />
                <ComboBoxItem Content="标准（推荐）" Tag="5" />
                <ComboBoxItem Content="较高" Tag="7" />
                <ComboBoxItem Content="极限（最慢）" Tag="9" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="解压覆盖策略" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
            <ComboBox x:Name="OverwriteCombo" Grid.Column="1" Height="34" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="250">
                <ComboBoxItem Content="每次询问" Tag="Ask" />
                <ComboBoxItem Content="直接覆盖" Tag="Overwrite" />
                <ComboBoxItem Content="跳过已存在文件" Tag="Skip" />
                <ComboBoxItem Content="自动重命名" Tag="Rename" />
            </ComboBox>
        </Grid>

        <Border Grid.Row="4" Margin="0,16,0,0" Padding="14,12" CornerRadius="10"
                Background="#F8FAFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Windows 系统集成" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="AssociationStatusText" Margin="0,6,0,0" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="AssociateButton" Content="设为默认解压程序" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="0,0,8,8" Click="Associate_Click" />
                    <Button x:Name="OpenDefaultAppsButton" Content="打开默认应用设置" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="0,0,8,8" Click="OpenDefaultApps_Click" />
                    <Button x:Name="UnassociateButton" Content="取消关联" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="0,0,8,8" Click="Unassociate_Click" />
                </WrapPanel>
                <WrapPanel>
                    <Button x:Name="RegisterMenuButton" Content="注册右键菜单" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="0,0,8,8" Click="RegisterMenu_Click" />
                    <Button x:Name="UnregisterMenuButton" Content="移除右键菜单" Style="{StaticResource GhostButton}"
                            Padding="12,6" Margin="0,0,8,8" Click="UnregisterMenu_Click" />
                </WrapPanel>
                <TextBlock Text="右键菜单：选中文件/文件夹可压缩到本目录；右键压缩包可解压到本目录或指定目录。"
                           FontSize="11" Foreground="#9AA7BC" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5" Text="设置文件以明文保存在程序目录 config/settings.json 中。"
                   FontSize="12" Foreground="#9AA7BC" Margin="0,18,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource GhostButton}" MinWidth="96" Click="Cancel_Click" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="10,0,0,0" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
