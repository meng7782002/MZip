<Window x:Class="JsjmZip.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入密码" Width="440" Height="290"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="该压缩包已加密" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="ArchiveNameText" Grid.Row="1" Margin="0,6,0,0" FontSize="12"
                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Row="2" Text="请输入解压密码" Margin="0,18,0,6" Foreground="{StaticResource SubTextBrush}" />
        <PasswordBox x:Name="PwdBox" Grid.Row="3" Style="{StaticResource PasswordInput}" KeyDown="PwdBox_KeyDown" />

        <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="0,8,0,0" FontSize="12" Foreground="#D14343"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}" MinWidth="88" Click="Cancel_Click" IsCancel="True" />
            <Button Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="10,0,0,0"
                    Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
