<Window x:Class="JsjmZip.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 JsjmZip" Width="500" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource AccentLightBrush}">
                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="JsjmZip" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="版本 1.0.0" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0" />
                <TextBlock Text="西安极速聚米软件科技有限公司" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="轻量、易用的 Windows 压缩解压工具，支持 ZIP / 7Z 的创建与 RAR 的解压。"
                   TextWrapping="Wrap" Margin="0,20,0,0" Foreground="{StaticResource TextBrush}" />

        <Border Grid.Row="2" Background="#F7F9FD" CornerRadius="10" Padding="16,14" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock x:Name="EngineText" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                <TextBlock Text="压缩引擎：7-Zip（LGPL 许可，RAR 解压受 unRAR 限制条款约束）"
                           FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="日志目录：程序目录 logs。所有关键操作与异常均记录日志。"
                           FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="RAR 为专有格式，本程序仅提供解压能力，不支持创建 RAR 压缩包。"
                       TextWrapping="Wrap" FontSize="12" Foreground="#9AA7BC" />
            <TextBlock Text="版权所有 © 西安极速聚米软件科技有限公司"
                       TextWrapping="Wrap" FontSize="12" Foreground="#9AA7BC" Margin="0,6,0,0" />
        </StackPanel>

        <Button Grid.Row="4" Content="关闭" Style="{StaticResource PrimaryButton}" MinWidth="96"
                HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" />
    </Grid>
</Window>
